# LLM provider selection
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=TrueSource

EXA_API_KEY=

# Development auth mode
DEV_AUTH_MODE=true
DEV_AUTH_ROLE=administrator

DATABASE_URL=postgresql+psycopg://truesource:truesource@localhost:5432/truesource

# CopilotKit
COPILOTKIT_RUNTIME_URL=
COPILOTKIT_AGENT_ID=truesource_guardian
NEXT_PUBLIC_COPILOTKIT_RUNTIME_URL=
NEXT_PUBLIC_COPILOTKIT_AGENT_ID=truesource_guardian

# Browser-accessible backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock service URLs for non-Docker local runs
AWS_MOCK_URL=http://localhost:8001
GITLAB_MOCK_URL=http://localhost:8002
JIRA_MOCK_URL=http://localhost:8003
SERVICENOW_MOCK_URL=http://localhost:8004
CONFLUENCE_MOCK_URL=http://localhost:8005
SHAREPOINT_MOCK_URL=http://localhost:8006
